{
  "version": 1,
  "note": "평문 시크릿/자격증명/규제 개인정보(중요정보) 탐지 패턴. 국내외 컴플라이언스 기준(개인정보보호법 고유식별정보, PCI-DSS, ISMS-P, OWASP, CWE) 매핑. stdlib 정규식만 사용(폐쇄망). 코드 수정 없이 이 파일만 늘려 확장. enabled:false 는 SAST_SECRETS_ALL=1 로 켠다. group>0 이면 시크릿 값이 캡처그룹에 있음.",

  "placeholder_deny": [
    "changeme", "change_me", "change-me", "password", "passwd", "secret", "example",
    "examplekey", "test", "testkey", "dummy", "sample", "your_", "yourkey", "your-key",
    "xxxx", "xxxxxxxx", "<", "${", "{{", "process.env", "os.environ", "os.getenv",
    "getenv", "null", "none", "true", "false", "123456", "12345678", "admin",
    "placeholder", "redacted", "******", "notreal", "fake", "todo"
  ],

  "patterns": [
    {"id": "github-pat", "name": "GitHub Personal Access Token", "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}\\b", "category": "hardcoded-secret", "severity": "critical", "cwe": ["CWE-798"], "compliance": ["OWASP-A07:2021", "ISMS-P", "GitHub-Token"]},
    {"id": "github-pat-fine", "name": "GitHub Fine-grained PAT", "regex": "\\bgithub_pat_[0-9a-zA-Z_]{22,}\\b", "category": "hardcoded-secret", "severity": "critical", "cwe": ["CWE-798"], "compliance": ["OWASP-A07:2021", "ISMS-P"]},
    {"id": "aws-access-key", "name": "AWS Access Key ID", "regex": "\\b(?:AKIA|ASIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA)[A-Z0-9]{16}\\b", "validator": "aws_key", "category": "hardcoded-secret", "severity": "critical", "cwe": ["CWE-798"], "compliance": ["PCI-DSS-3.2", "OWASP-A07:2021", "AWS"]},
    {"id": "aws-secret-key", "name": "AWS Secret Access Key", "regex": "(?i)aws_?secret_?(?:access_?)?key\\s*[:=]\\s*['\"]([A-Za-z0-9/+=]{40})['\"]", "group": 1, "category": "hardcoded-secret", "severity": "critical", "cwe": ["CWE-798"], "compliance": ["PCI-DSS-3.2", "AWS"]},
    {"id": "google-api-key", "name": "Google API Key", "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b", "category": "hardcoded-secret", "severity": "high", "cwe": ["CWE-798"], "compliance": ["OWASP-A07:2021", "GCP"]},
    {"id": "slack-token", "name": "Slack Token", "regex": "\\bxox[baprs]-[0-9A-Za-z-]{10,48}\\b", "category": "hardcoded-secret", "severity": "high", "cwe": ["CWE-798"], "compliance": ["OWASP-A07:2021"]},
    {"id": "slack-webhook", "name": "Slack Webhook URL", "regex": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/_+-]{20,}", "category": "hardcoded-secret", "severity": "medium", "cwe": ["CWE-798"], "compliance": ["OWASP-A07:2021"]},
    {"id": "stripe-key", "name": "Stripe Live Secret Key", "regex": "\\b(?:sk|rk)_live_[0-9a-zA-Z]{20,}\\b", "category": "hardcoded-secret", "severity": "critical", "cwe": ["CWE-798"], "compliance": ["PCI-DSS-3.2", "Stripe"]},
    {"id": "private-key", "name": "Private Key (PEM)", "regex": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----", "category": "hardcoded-secret", "severity": "critical", "cwe": ["CWE-321"], "compliance": ["OWASP-A02:2021", "ISMS-P"]},
    {"id": "jwt-token", "name": "JWT", "regex": "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\b", "validator": "jwt", "category": "hardcoded-secret", "severity": "medium", "cwe": ["CWE-522"], "compliance": ["OWASP-A07:2021"]},
    {"id": "npm-token", "name": "npm Access Token", "regex": "\\bnpm_[A-Za-z0-9]{36}\\b", "category": "hardcoded-secret", "severity": "high", "cwe": ["CWE-798"], "compliance": ["OWASP-A07:2021"]},
    {"id": "db-uri-credential", "name": "DB 접속 URI(계정:비밀번호)", "regex": "(?i)\\b(?:mysql|mariadb|postgres(?:ql)?|mongodb(?:\\+srv)?|redis|amqp|mssql|sqlserver)://[^\\s:@/]+:([^\\s@/]{1,})@[^\\s/]+", "group": 1, "category": "hardcoded-secret", "severity": "critical", "cwe": ["CWE-798"], "compliance": ["PCI-DSS-3.2", "ISMS-P", "개인정보보호법"]},
    {"id": "jdbc-password", "name": "JDBC 접속 비밀번호", "regex": "(?i)jdbc:[a-z0-9]+:[^\\s'\"]*?[?&;](?:password|pwd)=([^\\s&;'\"]+)", "group": 1, "category": "hardcoded-secret", "severity": "critical", "cwe": ["CWE-798"], "compliance": ["PCI-DSS-3.2", "ISMS-P"]},
    {"id": "basic-auth-url", "name": "URL 내 Basic 인증정보", "regex": "(?i)\\bhttps?://[^\\s:@/]+:([^\\s@/]{3,})@", "group": 1, "category": "hardcoded-secret", "severity": "high", "cwe": ["CWE-798"], "compliance": ["OWASP-A07:2021", "ISMS-P"]},
    {"id": "generic-secret-assign", "name": "하드코딩 자격증명(키/비밀번호 대입)", "regex": "(?i)\\b(?:api[_-]?key|secret[_-]?key|client[_-]?secret|access[_-]?token|auth[_-]?token|secret|passwd|password|pwd|db[_-]?pass(?:word)?)\\b\\s*[:=]\\s*['\"]([^'\"]{5,120})['\"]", "group": 1, "placeholder_check": true, "entropy_min": 2.6, "category": "hardcoded-secret", "severity": "high", "cwe": ["CWE-798"], "compliance": ["OWASP-A07:2021", "ISMS-P", "CWE-259"]},

    {"id": "kr-rrn", "name": "주민등록번호", "regex": "\\b(\\d{6})[-\\s]?([1-8]\\d{6})\\b", "validator": "rrn", "category": "sensitive-data", "severity": "critical", "cwe": ["CWE-359"], "compliance": ["개인정보보호법-고유식별정보", "ISMS-P", "PIPA"]},
    {"id": "kr-driver-license", "name": "운전면허번호", "regex": "\\b\\d{2}-\\d{2}-\\d{6}-\\d{2}\\b", "category": "sensitive-data", "severity": "high", "cwe": ["CWE-359"], "compliance": ["개인정보보호법-고유식별정보", "PIPA"]},
    {"id": "kr-passport", "name": "여권번호(추정)", "regex": "\\b[MSRODmsrod]\\d{8}\\b", "category": "sensitive-data", "severity": "high", "cwe": ["CWE-359"], "compliance": ["개인정보보호법-고유식별정보", "PIPA"]},
    {"id": "kr-biz-reg", "name": "사업자등록번호(추정)", "regex": "\\b\\d{3}-\\d{2}-\\d{5}\\b", "category": "sensitive-data", "severity": "medium", "cwe": ["CWE-359"], "compliance": ["개인정보보호법", "PIPA"]},
    {"id": "kr-phone", "name": "휴대전화번호", "regex": "\\b01[016-9][-\\s]?\\d{3,4}[-\\s]?\\d{4}\\b", "enabled": false, "category": "sensitive-data", "severity": "low", "cwe": ["CWE-359"], "compliance": ["개인정보보호법", "PIPA"]},
    {"id": "credit-card", "name": "신용카드번호", "regex": "\\b(?:4\\d{12}(?:\\d{3})?|5[1-5]\\d{14}|3[47]\\d{13}|6(?:011|5\\d{2})\\d{12}|(?:2131|1800|35\\d{3})\\d{11})\\b", "validator": "luhn", "category": "sensitive-data", "severity": "critical", "cwe": ["CWE-311"], "compliance": ["PCI-DSS-3.4", "개인정보보호법", "ISMS-P"]},
    {"id": "us-ssn", "name": "US Social Security Number", "regex": "\\b(?!000|666|9\\d\\d)\\d{3}-(?!00)\\d{2}-(?!0000)\\d{4}\\b", "category": "sensitive-data", "severity": "high", "cwe": ["CWE-359"], "compliance": ["GDPR", "HIPAA", "US-SSN"]},
    {"id": "email-address", "name": "이메일 주소", "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b", "enabled": false, "category": "sensitive-data", "severity": "low", "cwe": ["CWE-359"], "compliance": ["개인정보보호법", "GDPR"]}
  ]
}
